{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "glanz-mcp",
      "version": "0.1.0",
      "title": "Glanz Detailing"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List all detailing services offered by Glanz, optionally filtered by category (exterior, interior, pelicula). Returns slug, name, category, and short summary for each service.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter.",
              "type": "string",
              "enum": [
                "exterior",
                "interior",
                "pelicula"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_service",
        "title": "Get service details",
        "description": "Get full details for a Glanz detailing service by slug, including description, benefits, process steps, packages/pricing, and FAQs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Service slug, e.g. 'recubrimiento-ceramico', 'ppf', 'polarizado-de-ventanas'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_business_info",
        "title": "Get business info",
        "description": "Get Glanz contact information: phone, email, address, business hours, and city.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
